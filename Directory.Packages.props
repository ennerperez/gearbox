    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="$(TargetFrameworkPackageVersion)"/>
