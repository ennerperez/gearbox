    <PackageVersion Include="Microsoft.Extensions.Configuration.Ini" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0"/>
    <PackageVersion Include="Microsoft.Extensions.Caching.Postgres" Version="1.2.2"/>
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.1"/>
    <PackageVersion Include="Nuke.Common" Version="10.1.0"/>
    <PackageVersion Include="Squid-Box.SevenZipSharp" Version="1.6.2.24"/>
    <PackageVersion Include="NUnit.ConsoleRunner" Version="3.20.2"/>
    <PackageVersion Include="xunit.runner.console" Version="2.9.3"/>
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.30.0.144632"/>
