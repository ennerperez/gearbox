    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3"/>
    <PackageVersion Include="Npgsql" Version="10.0.3"/>
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="$(TargetFrameworkPackageVersion)"/>
