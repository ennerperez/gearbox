<Project>
  <PropertyGroup Label="Framework" Condition="'$(UseMaui)' != 'true'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Label="Framework" Condition="'$(UseMaui)' == 'true'">
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <TargetFrameworkPackageVersion>10.0.10</TargetFrameworkPackageVersion>
    <AvaloniaPackageVersion>12.1.1</AvaloniaPackageVersion>
    <SkiaSharpPackageVersion>4.150.1</SkiaSharpPackageVersion>
    <BuildPackageVersion>18.8.2</BuildPackageVersion>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.5.2"/>
    <PackageVersion Include="Datadog.Trace.Bundle" Version="3.49.0"/>
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0"/>
    <PackageVersion Include="NuGet.Packaging" Version="7.6.0"/>
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="UnitsNet" Version="5.75.1"/>
    <PackageVersion Include="FluentValidation" Version="12.1.1"/>
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2"/>
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2"/>
    <PackageVersion Include="Refit" Version="11.2.0"/>
    <PackageVersion Include="Refit.HttpClientFactory" Version="11.2.0"/>
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.3"/>
    <PackageVersion Include="ConfigurationSubstitutor" Version="1.5.1"/>
    <PackageVersion Include="DotNetEnv" Version="3.2.0"/>
    <PackageVersion Include="Dapper" Version="2.1.79"/>
    <PackageVersion Include="Auth0.AspNetCore.Authentication" Version="1.6.1"/>
    <PackageVersion Include="Blazor.SessionStorage" Version="10.0.0"/>
    <PackageVersion Include="ExcelDataReader" Version="3.9.0"/>
    <PackageVersion Include="ExcelDataReader.DataSet" Version="3.9.0"/>
    <PackageVersion Include="Humanizer.Core" Version="3.0.10"/>
    <PackageVersion Include="Humanizer.Core.es" Version="3.0.10"/>
    <PackageVersion Include="Radzen.Blazor" Version="11.1.6"/>
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.0.0"/>
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0"/>
    <PackageVersion Include="Auth0.ManagementApi" Version="7.46.0"/>
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1"/>
    <PackageVersion Include="SystemTextJsonPatch" Version="5.0.0"/>
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="$(TargetFrameworkPackageVersion)"/>
    <PackageVersion Include="Microsoft.Build" Version="$(BuildPackageVersion)"/>
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="$(BuildPackageVersion)"/>
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="$(BuildPackageVersion)"/>
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.1"/>
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.6.0"/>
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.21.2"/>
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2"/>
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.19.2"/>
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2"/>
    <PackageVersion Include="EFCore.BulkExtensions.PostgreSql" Version="10.0.1"/>
    <PackageVersion Include="Nanoid" Version="3.1.0"/>
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5"/>
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4"/>
    <PackageVersion Include="Newtonsoft.Json.Bson" Version="1.0.3"/>
    <PackageVersion Include="QuestPDF" Version="2026.7.1"/>
