<Styles xmlns="https://github.com/avaloniaui" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="ScrollBar">
        <Style.Resources>
            <x:Double x:Key="ScrollBarSize">12</x:Double>
        </Style.Resources>

        <Setter Property="ShowDelay" Value="0:0:0.1"/>
        <Setter Property="HideDelay" Value="0:0:0.2"/>
    </Style>
    <Style Selector="Window">
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
        <!--<Setter Property="ExtendClientAreaChromeHints" Value="NoChrome" />-->
        <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="-1" />
        <Setter Property="WindowDecorations" Value="None" />
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.Container">
        <Setter Property="Background" Value="{DynamicResource Brush.Window}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Border">
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Button.IconButton, RepeatButton.IconButton">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.CloseButton">
        <Setter Property="Background" Value="{DynamicResource Color.Danger}" />
    </Style>

    <Style Selector="Border.TitleBar">
        <Setter Property="Background" Value="{DynamicResource Brush.TitleBar}" />
        <Setter Property="CornerRadius" Value="2,2,0,0" />
    </Style>
    <Style Selector="Button.ChromeButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Image.ChromeIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="StackPanel.WindowTitle">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Image.WindowTitleIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="TextBlock.WindowTitleText">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="WrapPanel.BrowserPanel">
        <Setter Property="Margin" Value="16,0,16,0" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemsAlignment" Value="Center" />
        <Setter Property="ItemSpacing" Value="8" />
        <Setter Property="LineSpacing" Value="8" />
    </Style>
    <Style Selector="Button.BrowserCard">
        <Setter Property="Width" Value="112" />
        <Setter Property="Height" Value="112" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.BrowserCard:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.CardHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardAccentBorder}" />
    </Style>
    <Style Selector="Button.BrowserCard:pressed">
        <Setter Property="Background" Value="{DynamicResource Brush.CardPressed}" />
    </Style>
    <Style Selector="StackPanel.BrowserCardContent">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Svg.BrowserCardIcon">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="TextBlock.BrowserCardName">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
    </Style>

    <Style Selector="StackPanel.AboutContent">
        <Setter Property="Margin" Value="16" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Spacing" Value="18" />
    </Style>
    <Style Selector="Border.AboutHeroIconFrame">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="96" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Brush.TitleBar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Image.AboutHeroIcon">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.AboutHeroText">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="TextBlock.AboutTitle">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.AboutTagline">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Opacity" Value="0.86" />
    </Style>
    <Style Selector="TextBlock.AboutMuted">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Border.AboutSection">
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="StackPanel.AboutSectionContent">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="TextBlock.AboutSectionTitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.AboutLabel">
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.AboutValue">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.AboutPurpose">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>
</Styles>
