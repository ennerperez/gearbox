<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Condition="$(MSBuildProjectFile.Contains('Tests'))">
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectFile.Contains('Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="Bogus" />
    <PackageReference Include="NSubstitute"/>
    <PackageReference Include="Shouldly"/>
    <PackageReference Include="NetArchTest.eNhancedEdition"/>
    <PackageReference Include="AutoFixture"/>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="xUnit" Condition="'$(TestExecutionFramework)' == 'xUnit' AND $(MSBuildProjectFile.Contains('Tests'))">
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="xunit.v3.extensibility.core"/>
    <PackageReference Include="xunit.v3.runner.console">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio"/>
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Xunit.v3.Priority"/>
    <PackageReference Include="Verify.XunitV3"/>
    <None Update="xunit.runner.json" Condition="Exists('xunit.runner.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Label="Reqnroll" Condition="'$(UsingReqnroll)' == 'false' AND $(MSBuildProjectFile.Contains('Tests'))">
    <None Remove="reqnroll.json"/>
    <None Remove="reqnroll.*.json"/>
    <None Remove="**/*.feature"/>
    <Compile Remove="**/*.Reqnroll.cs"/>
    <Compile Remove="Helpers/*.cs"/>
    <Compile Remove="Hooks/*.cs"/>
    <Compile Remove="Steps/*.cs"/>
    <Compile Remove="Features/*.cs"/>
    <Compile Remove="Settings/*Reqnroll*.cs"/>
  </ItemGroup>
  <ItemGroup Label="Reqnroll" Condition="'$(UsingReqnroll)' == 'true' AND $(MSBuildProjectFile.Contains('Tests'))">
    <PackageReference Include="Reqnroll"/>
    <PackageReference Include="Reqnroll.Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Reqnroll.Tools.MsBuild.Generation"/>
    <PackageReference Condition="'$(TestExecutionFramework)' == 'NUnit'" Include="Reqnroll.NUnit"/>
    <PackageReference Condition="'$(TestExecutionFramework)' == 'xUnit'" Include="Reqnroll.xunit.v3"/>
    <PackageReference Condition="'$(TestExecutionFramework)' == 'TUnit'" Include="Reqnroll.TUnit"/>
    <Content Include="reqnroll.json" Condition="Exists('reqnroll.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="reqnroll.*.json" Condition="Exists('reqnroll.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>reqnroll.json</DependentUpon>
    </Content>
  </ItemGroup>
</Project>