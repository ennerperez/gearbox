<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- DefineConstants -->
  <PropertyGroup>
    <DefineConstants Condition="'$(BuildConstants)' != ''">$(BuildConstants)$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(BuildConstants)' == ''">$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <!-- Remove LatoFont (from QuestPDF) -->
  <Target Condition="'$(UsingQuestPDF)' == 'true'" Name="RemoveLatoFontAfterPublish" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)\LatoFont"/>
  </Target>

</Project>