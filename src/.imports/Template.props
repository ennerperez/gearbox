<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_DebugTemplate>false</_DebugTemplate>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">WINDOWS</DefineConstants>
    <DefineConstants Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">OSX</DefineConstants>
    <DefineConstants Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">LINUX</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Label="Template Paths">
    <SourceDirectory>$(MSBuildThisFileDirectory)..\..\</SourceDirectory>
    <_ImportDirectory>$(SourceDirectory)src\.imports\</_ImportDirectory>
    <_FilesDirectory>$(SourceDirectory)src\.files\</_FilesDirectory>
    <TestsDirectory>$(MSBuildThisFileDirectory)..\..\tests\</TestsDirectory>
    <_ConfigFile>$(SourceDirectory).config\dotnet-tools.json</_ConfigFile>
    <_EnvFile>$(SourceDirectory).env</_EnvFile>
  </PropertyGroup>

  <Import Condition="Exists('$(_ImportDirectory)Features.props')" Project="$(_ImportDirectory)Features.props"/>
  <Import Condition="Exists('$(_ImportDirectory)Project.props')" Project="$(_ImportDirectory)Project.props"/>

  <Import Condition="Exists('$(MSBuildProjectDirectory)\Options.props')" Project="$(MSBuildProjectDirectory)\Options.props"/>

</Project>