<Solution>
  <Folder Name="/.config/">
    <File Path=".config/dotnet-tools.json" />
  </Folder>
  <Folder Name="/.files/">
    <File Path=".aiignore" />
    <File Path=".dockerignore" />
    <File Path=".editorconfig" />
    <File Path=".editoricon.png" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path=".markdownlint.json" />
    <File Path="AGENTS.md" />
    <File Path="build.cmd" />
    <File Path="build.ps1" />
    <File Path="build.sh" />
    <File Path="CHANGELOG.md" />
    <File Path="coverage.runsettings" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="GitVersion.yml" />
    <File Path="global.json" />
    <File Path="LICENSE" />
    <File Path="Makefile" />
    <File Path="NuGet.config" />
    <File Path="qodana.yaml" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/build/">
    <Project Path="build/_build.csproj">
      <Build Project="false" />
    </Project>
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/Core/Core.csproj" />
    <Project Path="src/Host/Host.csproj" />
    <Project Path="src/Runner/Runner.csproj">
      <Deploy Solution="Release|*" />
    </Project>
    <Project Path="src/Shell/Shell.csproj" />
  </Folder>
  <Folder Name="/src/.imports/">
    <File Path="src/.imports/AssemblyInfo.props" />
    <File Path="src/.imports/Features.props" />
    <File Path="src/.imports/Features.targets" />
    <File Path="src/.imports/Project.props" />
    <File Path="src/.imports/Project.targets" />
    <File Path="src/.imports/Template.props" />
    <File Path="src/.imports/Template.targets" />
    <File Path="src\.imports\Tests.props" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/UnitTest/UnitTest.csproj" />
  </Folder>
</Solution>
